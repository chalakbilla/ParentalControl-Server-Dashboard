{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/v1/devices", "dest": "/api/devices.js" },
    { "src": "/api/v1/commands/(.*)", "dest": "/api/commands.js" },
    { "src": "/api/v1/commands", "dest": "/api/commands.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
